# Copy to .env for local development. Never commit a real .env file.

NODE_ENV=development
PORT=4000

# Postgres connection string.
DATABASE_URL="postgresql://uaa:CHANGE_ME@localhost:5432/uaa_dev?schema=public"

# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_VALUE"

# Origin the frontend is served from — used for CORS + cookie SameSite policy.
WEB_ORIGIN="http://localhost:5183"

# ── Stripe (required for real subscriptions/payments) ──
# Leave unset in development: the API responds with a clear
# "Configuration requise" state instead of pretending payments work.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PREMIUM=

# ── AI provider (required for real document analysis / chatbot) ──
# Leave unset to use the built-in mock provider, which is deterministic,
# clearly labeled as non-AI in its output, and never invents facts.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=

# Local disk storage root for uploaded documents (dev only — use object
# storage such as S3/R2 in production; see services/storage).
STORAGE_ROOT="./storage"
MAX_UPLOAD_MB=25
